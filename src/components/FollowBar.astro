---
import { SITE_X_URL, SITE_GITHUB_URL, SITE_LINKEDIN_URL } from '../site'
---

<section class="follow" aria-labelledby="follow-title">
  <h2 class="label" id="follow-title">[ follow ]</h2>
  <div class="follow-links">
    <a class="block-btn" href={SITE_X_URL} target="_blank" rel="noopener">x</a>
    <a class="block-btn" href="/rss.xml">rss</a>
    <a class="block-btn" href={SITE_GITHUB_URL} target="_blank" rel="noopener">github</a>
    <a class="block-btn" href={SITE_LINKEDIN_URL} target="_blank" rel="noopener">linkedin</a>
  </div>
</section>
