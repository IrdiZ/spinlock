---
import { SITE_BUTTONDOWN } from '../site'

// Email signup, posted straight to Buttondown. Renders nothing until SITE_BUTTONDOWN is set.
---

{
  SITE_BUTTONDOWN && (
    <form
      class="subscribe"
      action={`https://buttondown.com/api/emails/embed-subscribe/${SITE_BUTTONDOWN}`}
      method="post"
      target="_blank"
    >
      <label for="subscribe-email">new posts by email</label>
      <input id="subscribe-email" type="email" name="email" required placeholder="you@example.com" autocomplete="email" />
      <input type="hidden" name="embed" value="1" />
      <button type="submit">subscribe</button>
    </form>
  )
}
