---
export const prerender = true

import Layout from '../layouts/Layout.astro'
import ArtPanel from '../components/ArtPanel.astro'
import Wordmark from '../components/Wordmark.astro'
import Terminal from '../components/Terminal.astro'
import DebtTracker from '../components/DebtTracker.astro'
import FollowBar from '../components/FollowBar.astro'
import { getPosts } from '../lib/posts'
import { paintings } from '../lib/paintings'
import Subscribe from '../components/Subscribe.astro'
import { homeSchema } from '../lib/schema'
import { SITE_TITLE, SITE_BIO, SITE_REPO_URL, SITE_DOMAIN } from '../site'

const posts = await getPosts()
const base = Astro.site ?? new URL(`https://${SITE_DOMAIN}`)
const art = paintings.home

// Project panes on the home page. Each one links out to its public repo.
// Keep every blurb honest: no pane may claim more than the repo does.
const projects = [
  {
    name: 'voice cockpit',
    kind: 'voice',
    blurb: 'hands-free control of a web app. speech runs in the browser, and commands fire before you finish the sentence.',
    stack: 'typescript',
    url: 'https://github.com/IrdiZ/cutting-edge-voice-agent',
  },
  {
    name: 'albsub',
    kind: 'language',
    blurb: 'translates movie subtitles into albanian with any LLM, and checks every line it writes.',
    stack: 'typescript',
    url: 'https://github.com/IrdiZ/albsub',
  },
  {
    name: 'six systems',
    kind: 'data',
    blurb: 'a made-up hospital that measures how much of a "complete" patient file a computer can actually use.',
    stack: 'python',
    url: 'https://github.com/IrdiZ/six-systems',
  },
  {
    name: 'pgfp',
    kind: 'parallel',
    blurb: 'DNA sequence alignment in go, sequential and parallel, with benchmarks and a web UI.',
    stack: 'go',
    url: 'https://github.com/IrdiZ/pgfp',
  },
  {
    name: 'guitar tabs',
    kind: 'concept',
    blurb: 'an experiment: turn a guitar recording into tablature. it barely works today.',
    stack: 'python',
    url: 'https://github.com/IrdiZ/guitar-tabs',
  },
  {
    name: 'this site',
    kind: 'web',
    blurb: 'the blog you are reading. astro and one stylesheet.',
    stack: 'astro',
    url: SITE_REPO_URL,
  },
]

const iso = (d: Date) => d.toISOString().slice(0, 10)
---

<Layout
  title={SITE_TITLE}
  description="Irdi Zeneli, a CS student in Maastricht, building in public: indie products, systems deep dives, and a public scoreboard for paying off €20,000 of student debt."
  preloadArt={art}
  jsonLd={homeSchema(base)}
>
  <section class="split">
    <ArtPanel art={art} priority />
    <div class="split-text">
      <Wordmark />
      <Terminal comment="// spin until free" label="while debt is above zero, ship">
        <p class="t-code">
          <code><span class="t-kw">while</span> (<span class="t-var">debt</span> <span class="t-kw">&gt;</span> <span class="t-num">0</span>) <span class="t-fn">ship</span>();<span class="cursor" aria-hidden="true"></span></code>
        </p>
        <DebtTracker />
      </Terminal>
    </div>
  </section>

  <div class="wrap">
    <aside class="about-card" aria-label="about the author">
      <span class="about-tag">author</span>
      <img src="/me.jpg" alt="irdi" class="about-photo" width="400" height="400" />
      <div class="about-content">
        <strong>i'm irdi.</strong>
        <p>strict no-AI policy on the writing. (just kidding.)</p>
        <p>sometimes a model throws me a first draft. then i rewrite it until it sounds like me. typos included.</p>
        <p class="now"><span>now</span> finishing a computer science degree in maastricht, taking freelance work, and building something new.</p>
      </div>
    </aside>

    <div class="band" aria-hidden="true"></div>

    <section class="projects" id="projects" aria-labelledby="projects-title">
      <h2 class="label" id="projects-title">[ projects ]</h2>
      <div class="pane-grid">
        {
          projects.map((p) => (
            <a class="pane" href={p.url} target="_blank" rel="noopener">
              <span class="pane-kind">{p.kind}</span>
              <h3>{p.name}</h3>
              <p>{p.blurb}</p>
              <span class="pane-foot">
                <span>{p.stack}</span>
                <span class="pane-go">github</span>
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <div class="band" aria-hidden="true"></div>

    <section class="posts" id="posts" aria-labelledby="posts-title">
      <h2 class="label" id="posts-title">[ posts ]</h2>
      {posts.length === 0 && <p class="empty">no posts yet. the first one is being typed.</p>}
      {
        posts.length > 0 && (
          <ul class="post-list">
            {posts.map((post) => (
              <li class="post-row">
                <time datetime={post.data.date.toISOString()}>{iso(post.data.date)}</time>
                <div>
                  <a href={`/posts/${post.id}`}>{post.data.title}</a>
                  <p>{post.data.excerpt}</p>
                </div>
                {post.data.tags.length > 0 && <span class="post-tags">{post.data.tags.join(' / ')}</span>}
              </li>
            ))}
          </ul>
        )
      }
      {posts.length > 0 && <p class="all-posts"><a href="/posts">all posts</a></p>}
    </section>

    <Subscribe />

    <div class="band" aria-hidden="true"></div>

    <FollowBar />
  </div>
</Layout>
