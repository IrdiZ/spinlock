---
export const prerender = true

import Layout from '../layouts/Layout.astro'
import ProjectArt from '../components/ProjectArt.astro'
import { getPosts } from '../lib/posts'
import { getTimeline } from '../lib/projects'
import { paintings } from '../lib/paintings'
import Subscribe from '../components/Subscribe.astro'
import { homeSchema } from '../lib/schema'
import { SITE_TITLE, SITE_DOMAIN } from '../site'

const posts = await getPosts()
const base = Astro.site ?? new URL(`https://${SITE_DOMAIN}`)
const art = paintings.home
// Home rotation: one painting per visitor per day, picked in the browser (see ArtPanel).
const homePool = [
  paintings.home,
  paintings.klimtBirchForest,
  paintings.klimtSunflowers,
  paintings.klimtAttersee,
  paintings.klimtPearTree,
]

// Six projects that show the work: AI infra, voice, systems. Picked from the timeline
// (src/content/projects.yaml), each shown by its own picture or drawing. Public repos link to GitHub; the rest link to their place on /projects.
const PICKS = ['vox', 'sync-devices', 'pgfp', 'voice-cockpit', 'ct-jarvis', 'control-room']
const timeline = await getTimeline()
const projects = PICKS.map((id) => {
  const e = timeline.find((t) => t.id === id)
  if (!e?.data.media) throw new Error(`home project "${id}" needs media in projects.yaml`)
  const github = e.links.find((l) => l.label === 'github')
  return {
    name: e.data.name.replace(/, .*$/, ''),
    picture: e.data.media.poster ?? e.data.media.src,
    art: e.data.media.art,
    alt: e.data.media.alt,
    url: github?.href ?? `/projects#${e.id}`,
    go: github ? 'github' : 'timeline',
  }
})

const iso = (d: Date) => d.toISOString().slice(0, 10)
---

<Layout
  title={SITE_TITLE}
  description="Irdi Zeneli, harness and AI infra engineer at a startup, building in public: projects, systems deep dives and posts about what breaks."
  jsonLd={homeSchema(base)}
  art={art}
  pool={homePool}
>
  <h1 class="sr-only">spinlock, by Irdi Zeneli</h1>
  <p class="intro">i'm irdi. harness and ai infra engineer at a startup. i write about what i build and what breaks.</p>

  <section aria-labelledby="posts-title">
    <h2 id="posts-title">posts</h2>
    {posts.length === 0 && <p class="dim">no posts yet. the first one is being typed.</p>}
    <ul class="list">
      {posts.map((post) => (
        <li>
          <a href={`/posts/${post.id}`}>{post.data.title}</a>
          <time datetime={post.data.date.toISOString()}>{iso(post.data.date)}</time>
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="projects-title">
    <h2 id="projects-title">projects</h2>
    <ul class="shots">
      {projects.map((p) => (
        <li>
          <a href={p.url} target={p.go === 'github' ? '_blank' : undefined} rel={p.go === 'github' ? 'noopener' : undefined}>
            <div class="shot">
              {p.art ? <ProjectArt art={p.art} alt={p.alt} /> : <img src={p.picture} alt="" loading="lazy" decoding="async" />}
            </div>
            <span>{p.name}</span>
          </a>
        </li>
      ))}
    </ul>
    <p><a href="/projects">all projects, 2021 to now</a></p>
  </section>

  <Subscribe />
</Layout>
