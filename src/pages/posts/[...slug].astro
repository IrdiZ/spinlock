---
export const prerender = true

import Layout from '../../layouts/Layout.astro'
import { render, type CollectionEntry } from 'astro:content'
import { getPosts } from '../../lib/posts'
import { paintings } from '../../lib/paintings'
import Subscribe from '../../components/Subscribe.astro'
import { postSchema } from '../../lib/schema'
import { existsSync } from 'node:fs'
import { SITE_NAME, SITE_DOMAIN } from '../../site'

export async function getStaticPaths() {
  const posts = await getPosts()
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}

interface Props { post: CollectionEntry<'posts'> }
const { post } = Astro.props
const { Content } = await render(post)
const key = post.data.painting
if (key && !(key in paintings)) throw new Error(`Unknown painting "${key}" in post ${post.id}`)
const art = key ? paintings[key as keyof typeof paintings] : paintings.post

const iso = (d: Date) => d.toISOString().slice(0, 10)

// Share card: frontmatter override, else the generated public/og/<slug>.png (npm run og), else the site default.
const generated = `/og/${post.id}.png`
const ogImage = post.data.ogImage ?? (existsSync(`public${generated}`) ? generated : undefined)
const base = Astro.site ?? new URL(`https://${SITE_DOMAIN}`)
const jsonLd = postSchema(post, base, new URL(ogImage ?? '/og-spinlock.jpg', base).toString())
---

<Layout
  title={`${post.data.title} · ${SITE_NAME}`}
  description={post.data.excerpt}
  ogImage={ogImage}
  ogType="article"
  publishedTime={post.data.date.toISOString()}
  jsonLd={jsonLd}
  art={art}
>
  <article class="post">
    <header>
      <h1>{post.data.title}</h1>
      {post.data.subtitle && <p class="subtitle">{post.data.subtitle}</p>}
      <p class="meta" id="post-stats" data-slug={post.id}>
        <time datetime={post.data.date.toISOString()}>{iso(post.data.date)}</time>
        <span><span id="view-num">0</span> views</span>
        <button class="like-btn" id="like-btn" type="button" aria-label="Like this post">like <span id="like-num">0</span></button>
        <a id="share-btn" href={`/api/linkedin/start?slug=${post.id}`}>share on linkedin</a>
        <span class="share-state" id="share-state"></span>
      </p>
    </header>

    <div class="prose">
      <Content />
    </div>

    <Subscribe />
  </article>

  <script is:inline define:vars={{ slug: post.id }}>
    (() => {
      // share button success / error banner
      const params = new URLSearchParams(window.location.search)
      const shareBtn = document.getElementById('share-btn')
      const shareState = document.getElementById('share-state')
      if (params.has('shared') && shareBtn && shareState) {
        shareBtn.style.display = 'none'
        shareState.textContent = '✓ shared to linkedin'
        shareState.className = 'share-state shared'
      } else if (params.has('li_error') && shareState) {
        shareState.textContent = 'share failed: ' + (params.get('li_error') || 'unknown')
        shareState.className = 'share-state error'
      }

      // stable per-browser uid for like/view dedupe (no auth needed)
      function getUid() {
        try {
          let u = localStorage.getItem('vw_uid')
          if (!u) {
            u = (crypto.randomUUID && crypto.randomUUID()) ||
                (Math.random().toString(36).slice(2) + Date.now().toString(36))
            localStorage.setItem('vw_uid', u)
          }
          return u
        } catch {
          return null
        }
      }
      const uid = getUid()
      if (!uid) return

      const likeBtn = document.getElementById('like-btn')
      const likeNum = document.getElementById('like-num')
      const viewNum = document.getElementById('view-num')

      function fmt(n) {
        if (n < 1000) return String(n)
        if (n < 1_000_000) return (n / 1000).toFixed(n < 10_000 ? 1 : 0).replace(/\.0$/, '') + 'k'
        return (n / 1_000_000).toFixed(1).replace(/\.0$/, '') + 'm'
      }
      function paint(s) {
        if (s.likes != null && likeNum) likeNum.textContent = fmt(s.likes)
        if (s.views != null && viewNum) viewNum.textContent = fmt(s.views)
        if (s.liked != null && likeBtn) likeBtn.classList.toggle('liked', !!s.liked)
      }

      fetch(`/api/stats/${slug}?uid=${encodeURIComponent(uid)}`)
        .then((r) => r.ok ? r.json() : null)
        .then((d) => d && paint(d))
        .catch(() => {})

      fetch(`/api/view/${slug}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ uid }),
      })
        .then((r) => r.ok ? r.json() : null)
        .then((d) => d && d.views != null && paint({ views: d.views }))
        .catch(() => {})

      likeBtn?.addEventListener('click', async () => {
        // optimistic toggle for feel
        likeBtn.classList.toggle('liked')
        const res = await fetch(`/api/like/${slug}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ uid }),
        }).catch(() => null)
        if (!res || !res.ok) {
          likeBtn.classList.toggle('liked') // revert
          return
        }
        const d = await res.json()
        paint(d)
      })
    })()
  </script>
</Layout>
