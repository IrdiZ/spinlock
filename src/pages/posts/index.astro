---
export const prerender = true

import Layout from '../../layouts/Layout.astro'
import Subscribe from '../../components/Subscribe.astro'
import { getPosts } from '../../lib/posts'
import { paintings } from '../../lib/paintings'
import { person } from '../../lib/schema'
import { SITE_NAME, SITE_AUTHOR, SITE_DOMAIN } from '../../site'

const posts = await getPosts()
const base = Astro.site ?? new URL(`https://${SITE_DOMAIN}`)
const iso = (d: Date) => d.toISOString().slice(0, 10)

// Every post in one place, so search engines and readers have a hub that links to all of them.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SITE_NAME,
  url: new URL('/posts', base).toString(),
  author: person(base),
  blogPost: posts.map((p) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    url: new URL(`/posts/${p.id}`, base).toString(),
    datePublished: p.data.date.toISOString(),
  })),
}
---

<Layout
  title={`all posts · ${SITE_NAME}`}
  description={`Every post by ${SITE_AUTHOR} on spinlock: building in public, systems bugs, and AI infra.`}
  jsonLd={jsonLd}
  art={paintings.post}
>
  <h1>posts</h1>
  {posts.length === 0 && <p class="dim">no posts yet. the first one is being typed.</p>}
  <ul class="list list-long">
    {posts.map((post) => (
      <li>
        <a href={`/posts/${post.id}`}>{post.data.title}</a>
        <time datetime={post.data.date.toISOString()}>{iso(post.data.date)}</time>
        <p class="dim">{post.data.excerpt}</p>
      </li>
    ))}
  </ul>
  <Subscribe />
</Layout>
