---
export const prerender = true

import Layout from '../layouts/Layout.astro'
import ProjectArt from '../components/ProjectArt.astro'
import Subscribe from '../components/Subscribe.astro'
import { getTimeline, chapters, totals, monthly, when, fmt, type TimelineEntry } from '../lib/projects'
import { paintings } from '../lib/paintings'
import { projectsSchema } from '../lib/schema'
import { SITE_NAME, SITE_DOMAIN } from '../site'

const entries = await getTimeline()
const months = monthly(entries)
const t = totals(entries, months)
const base = Astro.site ?? new URL(`https://${SITE_DOMAIN}`)
const art = paintings.wheatstacks

// Newest first: the latest chapter on top, and the latest entry first inside each one.
const rowsFor = (id: string) => entries.filter((e) => e.data.chapter === id).reverse()

const commitCount = (n: number) => `${fmt(n)} commit${n === 1 ? '' : 's'}`
const stats = (e: TimelineEntry) =>
  [
    e.commits !== undefined
      ? e.total
        ? `${fmt(e.commits)} of ${commitCount(e.total)}`
        : commitCount(e.commits)
      : e.total && `${commitCount(e.total)} by the team`,
    e.days && e.days > 1 && `${e.days} active days`,
    e.data.manual?.lines && `~${fmt(e.data.manual.lines)} lines`,
    e.data.team,
    e.data.manual?.note,
  ].filter(Boolean) as string[]

const closedLabel = { private: 'private repo', local: 'no public link' }
---

<Layout
  title={`projects · ${SITE_NAME}`}
  description={`Every project Irdi Zeneli has built since 2021, on one timeline: ${t.projects} projects and ${fmt(t.commits)} commits, from high school in Tirana to building in public.`}
  ogImage="/og/projects.png"
  jsonLd={projectsSchema(entries, base)}
  art={art}
>
  <h1>projects</h1>
  <p class="dim">{t.projects} projects in {t.years} years, {fmt(t.commits)} commits. the ones worth showing.</p>

  {
    [...chapters].reverse().map((c) => (
      <section aria-labelledby={`${c.id}-title`} id={c.id}>
        <h2 id={`${c.id}-title`}>{c.title} <span class="dim">{c.years}</span></h2>
        <ul class="pj">
          {rowsFor(c.id).map((e) => (
            <li id={e.id} class:list={{ 'pj-small': e.data.type === 'milestone' || e.data.size === 'bside' }}>
              {e.data.type !== 'milestone' && e.data.size !== 'bside' && e.data.media && (
                <div class="pj-media">
                  {e.data.media.art ? (
                    <ProjectArt art={e.data.media.art} alt={e.data.media.alt} />
                  ) : e.data.media.video ? (
                    <video src={e.data.media.video} poster={e.data.media.poster} muted loop playsinline preload="none" aria-label={e.data.media.alt} data-loop />
                  ) : (
                    <img src={e.data.media.src} alt={e.data.media.alt} loading="lazy" decoding="async" />
                  )}
                </div>
              )}
              <p>
                <strong>{e.data.name}</strong>{' '}
                <time class="dim" datetime={when(e.data.date, e.data.precision)}>{e.data.now ? 'now' : when(e.data.date, e.data.precision)}</time>
              </p>
              <p>{e.data.blurb}</p>
              <p class="dim">
                {[e.data.stack, ...(e.data.type === 'milestone' ? [] : stats(e))].filter(Boolean).join(' · ')}
                {e.links.map((l) => (
                  <>
                    {' '}
                    <a href={l.href} target={l.href.startsWith('/') ? undefined : '_blank'} rel="noopener" aria-label={`${e.data.name}: ${l.label}`}>{l.label}</a>
                  </>
                ))}
                {e.closed && <> · {closedLabel[e.closed]}</>}
              </p>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <Subscribe />
</Layout>

<script>
  // Loops play only while on screen, and never with reduced motion: then the poster stays.
  const still = window.matchMedia('(prefers-reduced-motion: reduce)')
  const videos = document.querySelectorAll<HTMLVideoElement>('video[data-loop]')
  const io = new IntersectionObserver(
    (seen) => {
      for (const { target, isIntersecting } of seen) {
        const v = target as HTMLVideoElement
        if (isIntersecting && !still.matches) v.play().catch(() => {})
        else v.pause()
      }
    },
    { rootMargin: '200px 0px' },
  )
  videos.forEach((v) => io.observe(v))
</script>
